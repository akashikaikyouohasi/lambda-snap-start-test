# Copy this file to samconfig.toml and fill in __REPLACE__ values.
# samconfig.toml is git-ignored so secrets stay local.
version = 0.1

[default.deploy.parameters]
stack_name = "lambda-snap-start-test-go"
region = "ap-northeast-1"
capabilities = "CAPABILITY_IAM CAPABILITY_AUTO_EXPAND"
resolve_s3 = true
confirm_changeset = false
parameter_overrides = "NewRelicLicenseKey=__REPLACE__ NewRelicAccountId=__REPLACE__ NewRelicExtensionLayerVersion=73"
